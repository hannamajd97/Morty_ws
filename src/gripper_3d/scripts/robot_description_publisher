#!/usr/bin/env python3

import argparse
from pathlib import Path
import sys

import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from rclpy.utilities import remove_ros_args
from std_msgs.msg import String


class RobotDescriptionPublisher(Node):
    def __init__(self, robot_description: str, topic: str = "robot_description_full"):
        super().__init__("robot_description_publisher")
        qos = QoSProfile(depth=1)
        qos.durability = DurabilityPolicy.TRANSIENT_LOCAL
        qos.reliability = ReliabilityPolicy.RELIABLE

        # 2026-09-02 (SYSTEM_STATE_LOG #309): DEDICATED topic. On the shared
        # /robot_description, robot_state_publisher's latched 17-link URDF
        # and this node's full 19-link MoveIt wrapper were BOTH delivered
        # to RViz, which rebuilt the RobotModel on each and flipped between
        # two robots (red status, arm not drawn). RViz reads
        # /robot_description_full; this node is its only publisher.
        self.publisher = self.create_publisher(String, topic, qos)
        self.message = String(data=robot_description)

        self.publisher.publish(self.message)
        # 2026-09-02 (SYSTEM_STATE_LOG #306): NO periodic republish. The
        # topic is TRANSIENT_LOCAL (latched), so late joiners receive the
        # description anyway. The old 1 Hz timer made RViz's RobotModel
        # and PlanningScene displays re-parse the URDF and reload every
        # mesh once per second — the render thread at 90% and +2 MB/s of
        # memory with NO point cloud on screen ("fps drops with time").
        # Kept as a 10-minute heartbeat only, in case a subscriber ever
        # misses the latched sample.
        self.timer = self.create_timer(600.0, self._republish)

    def _republish(self):
        self.publisher.publish(self.message)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("urdf_file", help="URDF file path to publish")
    parser.add_argument("--topic", default="robot_description_full",
                        help="topic to latch the description on")
    stripped_args = remove_ros_args(args=sys.argv)
    args = parser.parse_args(args=stripped_args[1:])

    urdf_path = Path(args.urdf_file)
    robot_description = urdf_path.read_text(encoding="utf-8")

    rclpy.init(args=stripped_args)
    node = RobotDescriptionPublisher(robot_description, args.topic)
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        try:
            if rclpy.ok():
                rclpy.shutdown()
        except Exception:
            pass


if __name__ == "__main__":
    main()
