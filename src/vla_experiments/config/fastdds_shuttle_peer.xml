<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast-DDS profile for laptop processes that must talk to the shuttle PC
  (tory, 168.192.1.102) over the direct dock-Ethernet link: RViz, the VLA
  recorder, anything subscribing to /astra/*.
  UDP-only like fastdds_udp_only.xml, on all interfaces (no whitelist: a whitelist on the dock NIC made every process
  deaf whenever the dock link dropped, 2026-09-03); the shuttle is an
  explicit unicast initial peer; 16 MB socket buffers (effective only after
  sysctl net.core.rmem_max/wmem_max are raised). Use with
    export FASTRTPS_DEFAULT_PROFILES_FILE=$HOME/morty_ws/config/fastdds_shuttle_peer.xml
  (2026-09-02) If the shuttle address changes, edit the <address> below.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm_local</transport_id>
      <type>SHM</type>
      
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shuttle_peer_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
        <transport_id>shm_local</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>239.255.0.1</address><port>7400</port></udpv4></locator>  <!-- keep default multicast discovery: setting initialPeersList otherwise removes it -->
          <locator>
            <udpv4>
              <address>168.192.1.102</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.2.2</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
