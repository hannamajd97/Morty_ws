#!/usr/bin/env python3

import math

import rclpy
from geometry_msgs.msg import Pose
from rclpy.node import Node
from rclpy.parameter import Parameter
from shape_msgs.msg import SolidPrimitive
from std_msgs.msg import ColorRGBA
from visualization_msgs.msg import MarkerArray  # noqa: F401 (kept for symmetry with marker publisher)

from moveit_msgs.msg import CollisionObject, ObjectColor, PlanningScene
from moveit_msgs.srv import ApplyPlanningScene


def _quat_from_rpy(roll: float, pitch: float, yaw: float) -> tuple[float, float, float, float]:
    cy = math.cos(yaw * 0.5)
    sy = math.sin(yaw * 0.5)
    cp = math.cos(pitch * 0.5)
    sp = math.sin(pitch * 0.5)
    cr = math.cos(roll * 0.5)
    sr = math.sin(roll * 0.5)

    qw = cr * cp * cy + sr * sp * sy
    qx = sr * cp * cy - cr * sp * sy
    qy = cr * sp * cy + sr * cp * sy
    qz = cr * cp * sy - sr * sp * cy
    return (qx, qy, qz, qw)


class PlanningSceneEnvironmentPublisher(Node):
    def __init__(self):
        # Parameters are expected to come from a shared YAML (see `ur3e_gripper_3d_moveit_config/config/environment.yaml`).
        # Allow the node to run without explicit `declare_parameter` boilerplate.
        super().__init__(
            "planning_scene_environment_publisher",
            allow_undeclared_parameters=True,
            automatically_declare_parameters_from_overrides=True,
        )

        self.declare_parameter("apply_planning_scene_service", "/apply_planning_scene")
        self.declare_parameter("apply_retry_period_s", 0.5)

        self._require_parameters(
            [
                "frame_id",
                "publish_wall",
                "wall_size",
                "wall_xyz",
                "wall_rpy",
                "wall_rgba",
                "publish_table",
                "table_size",
                "table_xyz",
                "table_rpy",
                "table_rgba",
                "publish_mount_surface",
                "mount_surface_size",
                "mount_surface_xyz",
                "mount_surface_rpy",
                "mount_surface_rgba",
                "publish_flower",
                "flower_size",
                "flower_xyz",
                "flower_rpy",
                "flower_rgba",
                "flower_pose_is_center",
            ]
        )

        service_name = self.get_parameter("apply_planning_scene_service").get_parameter_value().string_value
        self._apply_cli = self.create_client(ApplyPlanningScene, service_name)
        self._apply_future = None

        retry_period = float(self.get_parameter("apply_retry_period_s").value)
        self._apply_timer = self.create_timer(max(0.1, retry_period), self._apply_once_when_ready)
        self.get_logger().info(f"Will apply environment via service: {service_name}")

    def _make_box(self, object_id: str, frame_id: str, size_xyz: list[float], pose: Pose) -> CollisionObject:
        primitive = SolidPrimitive()
        primitive.type = SolidPrimitive.BOX
        primitive.dimensions = [float(size_xyz[0]), float(size_xyz[1]), float(size_xyz[2])]

        co = CollisionObject()
        co.id = object_id
        co.header.frame_id = frame_id
        co.operation = CollisionObject.ADD
        co.primitives = [primitive]
        co.primitive_poses = [pose]
        return co

    def _require_parameters(self, names: list[str]) -> None:
        missing = []
        for name in names:
            p = self.get_parameter(name)
            if p.type_ == Parameter.Type.NOT_SET:
                missing.append(name)
        if missing:
            raise RuntimeError(
                "Missing required ROS parameters for planning_scene_environment_publisher: "
                + ", ".join(missing)
                + " (load ur3e_gripper_3d_moveit_config/config/environment.yaml)"
            )

    def _build_scene(self) -> PlanningScene:
        frame_id = self.get_parameter("frame_id").get_parameter_value().string_value

        scene = PlanningScene()
        scene.is_diff = True
        scene.object_colors = []

        if self.get_parameter("publish_wall").get_parameter_value().bool_value:
            wall_size = list(self.get_parameter("wall_size").get_parameter_value().double_array_value)
            wall_xyz = list(self.get_parameter("wall_xyz").get_parameter_value().double_array_value)
            wall_rpy = list(self.get_parameter("wall_rpy").get_parameter_value().double_array_value)
            qx, qy, qz, qw = _quat_from_rpy(float(wall_rpy[0]), float(wall_rpy[1]), float(wall_rpy[2]))

            wall_pose = Pose()
            wall_pose.position.x = float(wall_xyz[0])
            wall_pose.position.y = float(wall_xyz[1])
            wall_pose.position.z = float(wall_xyz[2])
            wall_pose.orientation.x = qx
            wall_pose.orientation.y = qy
            wall_pose.orientation.z = qz
            wall_pose.orientation.w = qw

            scene.world.collision_objects.append(self._make_box("wall", frame_id, wall_size, wall_pose))
            wall_rgba = list(self.get_parameter("wall_rgba").get_parameter_value().double_array_value)
            wall_color = ObjectColor()
            wall_color.id = "wall"
            wall_color.color = ColorRGBA(
                r=float(wall_rgba[0]),
                g=float(wall_rgba[1]),
                b=float(wall_rgba[2]),
                a=float(wall_rgba[3]),
            )
            scene.object_colors.append(wall_color)

        if self.get_parameter("publish_table").get_parameter_value().bool_value:
            table_size = list(self.get_parameter("table_size").get_parameter_value().double_array_value)
            table_xyz = list(self.get_parameter("table_xyz").get_parameter_value().double_array_value)
            table_rpy = list(self.get_parameter("table_rpy").get_parameter_value().double_array_value)
            qx, qy, qz, qw = _quat_from_rpy(float(table_rpy[0]), float(table_rpy[1]), float(table_rpy[2]))

            table_pose = Pose()
            table_pose.position.x = float(table_xyz[0])
            table_pose.position.y = float(table_xyz[1])
            table_pose.position.z = float(table_xyz[2])
            table_pose.orientation.x = qx
            table_pose.orientation.y = qy
            table_pose.orientation.z = qz
            table_pose.orientation.w = qw

            scene.world.collision_objects.append(self._make_box("table", frame_id, table_size, table_pose))
            table_rgba = list(self.get_parameter("table_rgba").get_parameter_value().double_array_value)
            table_color = ObjectColor()
            table_color.id = "table"
            table_color.color = ColorRGBA(
                r=float(table_rgba[0]),
                g=float(table_rgba[1]),
                b=float(table_rgba[2]),
                a=float(table_rgba[3]),
            )
            scene.object_colors.append(table_color)

        if self.get_parameter("publish_mount_surface").get_parameter_value().bool_value:
            ms_size = list(self.get_parameter("mount_surface_size").get_parameter_value().double_array_value)
            ms_xyz = list(self.get_parameter("mount_surface_xyz").get_parameter_value().double_array_value)
            ms_rpy = list(self.get_parameter("mount_surface_rpy").get_parameter_value().double_array_value)
            qx, qy, qz, qw = _quat_from_rpy(float(ms_rpy[0]), float(ms_rpy[1]), float(ms_rpy[2]))

            ms_pose = Pose()
            ms_pose.position.x = float(ms_xyz[0])
            ms_pose.position.y = float(ms_xyz[1])
            ms_pose.position.z = float(ms_xyz[2])
            ms_pose.orientation.x = qx
            ms_pose.orientation.y = qy
            ms_pose.orientation.z = qz
            ms_pose.orientation.w = qw

            scene.world.collision_objects.append(self._make_box("mount_surface", frame_id, ms_size, ms_pose))
            ms_rgba = list(self.get_parameter("mount_surface_rgba").get_parameter_value().double_array_value)
            ms_color = ObjectColor()
            ms_color.id = "mount_surface"
            ms_color.color = ColorRGBA(
                r=float(ms_rgba[0]),
                g=float(ms_rgba[1]),
                b=float(ms_rgba[2]),
                a=float(ms_rgba[3]),
            )
            scene.object_colors.append(ms_color)

        if self.get_parameter("publish_flower").get_parameter_value().bool_value:
            flower_size = list(self.get_parameter("flower_size").get_parameter_value().double_array_value)
            flower_xyz = list(self.get_parameter("flower_xyz").get_parameter_value().double_array_value)
            flower_rpy = list(self.get_parameter("flower_rpy").get_parameter_value().double_array_value)
            flower_pose_is_center = self.get_parameter("flower_pose_is_center").get_parameter_value().bool_value

            # If pose is not center, interpret pose like the original URDF "flower link" frame:
            # box is centered at (0, FLOWER_Y/2, 0) in the flower frame.
            if flower_pose_is_center:
                center_xyz = (float(flower_xyz[0]), float(flower_xyz[1]), float(flower_xyz[2]))
            else:
                center_xyz = (float(flower_xyz[0]), float(flower_xyz[1]) + float(flower_size[1]) / 2.0, float(flower_xyz[2]))

            qx, qy, qz, qw = _quat_from_rpy(float(flower_rpy[0]), float(flower_rpy[1]), float(flower_rpy[2]))
            flower_pose = Pose()
            flower_pose.position.x = center_xyz[0]
            flower_pose.position.y = center_xyz[1]
            flower_pose.position.z = center_xyz[2]
            flower_pose.orientation.x = qx
            flower_pose.orientation.y = qy
            flower_pose.orientation.z = qz
            flower_pose.orientation.w = qw

            scene.world.collision_objects.append(self._make_box("flower", frame_id, flower_size, flower_pose))
            flower_rgba = list(self.get_parameter("flower_rgba").get_parameter_value().double_array_value)
            flower_color = ObjectColor()
            flower_color.id = "flower"
            flower_color.color = ColorRGBA(
                r=float(flower_rgba[0]),
                g=float(flower_rgba[1]),
                b=float(flower_rgba[2]),
                a=float(flower_rgba[3]),
            )
            scene.object_colors.append(flower_color)

        scene.robot_state.is_diff = True
        return scene

    def _apply_once_when_ready(self) -> None:
        if self._apply_future is not None and not self._apply_future.done():
            return

        if not self._apply_cli.service_is_ready():
            self._apply_cli.wait_for_service(timeout_sec=0.01)
            return

        req = ApplyPlanningScene.Request()
        req.scene = self._build_scene()
        self._apply_future = self._apply_cli.call_async(req)
        self._apply_future.add_done_callback(self._on_applied)

    def _on_applied(self, fut) -> None:
        try:
            resp = fut.result()
        except Exception as exc:  # noqa: BLE001
            self.get_logger().warn(f"Failed to apply planning scene (will retry): {exc}")
            return

        if getattr(resp, "success", False):
            self.get_logger().info("Environment applied to MoveIt planning scene.")
            if self._apply_timer is not None:
                self._apply_timer.cancel()
                self._apply_timer = None
        else:
            self.get_logger().warn("ApplyPlanningScene returned success=false (will retry).")


def main():
    rclpy.init()
    node = PlanningSceneEnvironmentPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        try:
            if rclpy.ok():
                rclpy.shutdown()
        except Exception:
            pass


if __name__ == "__main__":
    main()
