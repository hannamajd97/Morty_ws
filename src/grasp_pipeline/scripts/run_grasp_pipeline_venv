#!/usr/bin/env bash
# Wrapper that runs the grasp_pipeline node from the same system Python the
# rest of the workspace uses. All required Python deps (ultralytics, zmq,
# numpy<2, ...) are installed in `~/.local/lib/python3.10/site-packages`,
# so no venv is needed.
set -e
set -o pipefail

# Resolve the workspace from this script's own location instead of a hardcoded
# name. Without this the wrapper silently fell back to ~/new_ur_gripper_ws and
# ran the OLD workspace's code even when launched from ~/morty_ws.
#
# NOTE: do NOT use `readlink -f` here. With `colcon build --symlink-install`
# this file is a symlink back into src/, so resolving the link lands in
# src/grasp_pipeline/scripts/ rather than the install tree. Instead walk up
# from the (unresolved) script location looking for install/setup.bash, which
# works whether we were invoked via the install symlink or directly.
# (Edited 2026-08-06.)
if [ -z "${WS_DIR:-}" ]; then
    _dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    while [ "${_dir}" != "/" ]; do
        if [ -f "${_dir}/install/setup.bash" ]; then
            WS_DIR="${_dir}"
            break
        fi
        _dir="$(dirname "${_dir}")"
    done
    WS_DIR="${WS_DIR:-${HOME}/new_ur_gripper_ws}"
fi

export AMENT_TRACE_SETUP_FILES="${AMENT_TRACE_SETUP_FILES:-}"
export AMENT_PYTHON_EXECUTABLE="${AMENT_PYTHON_EXECUTABLE:-}"
source /opt/ros/humble/setup.bash
source "${WS_DIR}/install/setup.bash"

exec /usr/bin/python3 -m grasp_pipeline.run_grasp_pipeline "$@"
