<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>morty_interfaces</name>
  <version>0.1.0</version>
  <description>
    Action, message, and service definitions shared across the
    grasp_pipeline, ur3e_gripper_3d_moveit_commander, and communication_llm
    packages. This package contains no logic; it only defines contracts.
  </description>

  <maintainer email="Majd.Hanna@student.reutlingen-university.de">Majd Hanna</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
